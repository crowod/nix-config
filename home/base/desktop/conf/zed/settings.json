{
  "preview_tabs": {
    "enable_preview_multibuffer_from_code_navigation": false,
    "enable_preview_from_multibuffer": true
  },
  "proxy": "",
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "languages": {
    "GDScript": {
      "tab_size": 1
    },
    "GDShader": {
      "hard_tabs": true
    }
  },
  "cli_default_open_behavior": "new_window",
  "agent_servers": {},
  "project_panel": {
    "dock": "left"
  },
  "disable_ai": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  }
}
